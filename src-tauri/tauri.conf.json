{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小智电脑版",
  "version": "0.3.0",
  "identifier": "me.xiaozhi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小智电脑版",
        "width": 900,
        "height": 760,
        "minWidth": 680,
        "minHeight": 600,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../THIRD-PARTY-NOTICES.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "小智电脑版：语音通话与桌面宠物",
    "category": "Utility",
    "windows": { "nsis": { "languages": ["SimpChinese", "English"] } }
  }
}
